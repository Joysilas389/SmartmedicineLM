# ---------------------------------------------------------------
# SmartMedicineLM environment variables
# Set these in Vercel: Project -> Settings -> Environment Variables
# Never commit real keys to GitHub.
# ---------------------------------------------------------------

# Which provider to use: anthropic | openai | demo
# If omitted, the app picks anthropic (if ANTHROPIC_API_KEY is set),
# then openai (if OPENAI_API_KEY is set), otherwise demo mode.
MODEL_PROVIDER=

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Any OpenAI-compatible API (OpenAI, Groq, OpenRouter, Together, a vLLM or Ollama server...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Set to true if the chosen model accepts images
OPENAI_VISION=true

# Optional: protects your API key. If set, the app asks for this code
# (Settings -> AI) before it can call the model.
APP_ACCESS_CODE=
